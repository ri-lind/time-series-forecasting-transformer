        },
        {
            "name": "makeglossaries",
            "command": "makeglossaries",
            "args": [
                "%DOCFILE%"
            ]
        },
        {
            "name": "biber",
            "command": "biber",
            "args": [
                "%DOCFILE%"
            ]
        }
    ],
    "latex-workshop.latex.recipe.default": "Seminar pdflatex -> glossaries -> biber -> pdflatex * 2",
    "latex-workshop.latex.autoBuild.run": "never"
